{
  "name": "anatscrawler",
  "version": "2.0.0",
  "description": "ANAT Security OSINT Platform",
  "license": "MIT",
  "scripts": {
    "build": "npm run build:client && npm run build:server",
    "build:client": "NODE_ENV=production vite build --config vite.config.ts",
    "build:server": "NODE_ENV=production esbuild server/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --external:express --external:mongoose --external:mongodb --external:passport --external:bcryptjs --external:jsonwebtoken --external:cookie-parser --external:cors --external:helmet --external:express-rate-limit --external:express-mongo-sanitize --external:express-session --external:express-validator --external:memorystore --external:dotenv --external:fast-levenshtein --external:node-fetch --external:fs --external:path --external:child_process --external:os --external:util --external:crypto --external:events --external:sqlite3",
    "start": "NODE_ENV=production node dist/index.js",
    "dev": "vite --config vite.config.ts",
    "dev:server": "NODE_ENV=development tsx watch server/index.ts",
    "deploy": "npm run build && pm2 restart anatscrawler",
    "clean": "rm -rf dist client/dist"
  },
