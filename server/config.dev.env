# Development Environment Configuration
# This file is used when testing with the remote server horus.anatsecurity.fr
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Skip database connection for development testing
SKIP_DATABASE_CONNECTION=true

# Development mode settings

# Timeout configurations
DB_QUERY_TIMEOUT=5000
DB_CONNECTION_TIMEOUT=10000
CLIENT_FETCH_TIMEOUT=30000
CLIENT_RETRY_DELAY=1000
CLIENT_MAX_RETRIES=2
